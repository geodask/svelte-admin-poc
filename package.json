{
	"name": "svelte-admin",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*"
		],
		"catalog": {
			"@eslint/js": "10.0.1",
			"@playwright/test": "1.65.0",
			"@sveltejs/adapter-node": "6.0.2",
			"@sveltejs/kit": "3.2.0",
			"@sveltejs/vite-plugin-svelte": "7.3.1",
			"@types/node": "22.20.5",
			"eslint": "10.14.0",
			"eslint-config-prettier": "10.1.8",
			"eslint-plugin-svelte": "3.24.1",
			"globals": "17.14.0",
			"prettier": "3.10.1",
			"prettier-plugin-svelte": "4.1.1",
			"svelte": "5.57.3",
			"svelte-check": "4.7.8",
			"typescript": "6.0.3",
			"typescript-eslint": "8.72.2",
			"vite": "8.3.8",
			"vitest": "5.1.0",
			"zod": "4.6.7"
		}
	},
	"engines": {
		"node": ">=22.17.0 <23"
	},
	"scripts": {
		"dev": "bun run --filter @svelte-admin/demo dev",
		"build": "bun run --filter @svelte-admin/demo build",
		"check": "bun run --filter '*' check",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test:unit": "bun run --filter @svelte-admin/core test",
		"test:e2e": "bun run --filter @svelte-admin/demo test:e2e"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/node": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
